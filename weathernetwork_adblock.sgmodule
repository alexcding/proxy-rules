#!name=The Weather Network Ad Removal
#!desc=Blocks the ad and tracking SDKs bundled in The Weather Network iOS app (com.theweathernetwork.weathereyeiphone): Google Ad Manager + IMA video ads, Amazon Publisher Services (DTB), Nimbus, ComScore, Kochava attribution, Microsoft Clarity session recording, and Firebase Analytics. Also collapses the anchored-banner blank strip by rewriting the app's own remote config (anchoredBannerAd → false) — no subscription/premium state is spoofed. The Rule section is device-wide domain rules (no MitM); the banner-collapse needs MitM on appframework.pelmorex.com only.
#!author=alexcding
#!category=Weather

[Rule]
# --- Google Ad Manager / AdMob (GADIsAdManagerApp; banner + native ads) ---
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN,adservice.google.com,REJECT
# Google IMA SDK (pre-roll video ads in JWPlayer streams)
DOMAIN,imasdk.googleapis.com,REJECT

# --- Amazon Publisher Services / DTB header bidding ---
# Confirmed in bundle: aax / aax-us-east / aax-dtb-mobile-geo / c / video-player.aps
DOMAIN-SUFFIX,amazon-adsystem.com,REJECT

# --- Nimbus (ads-by-nimbus exchange; app ships 6 Nimbus*Kit frameworks) ---
DOMAIN-SUFFIX,adsbynimbus.com,REJECT

# --- ComScore audience measurement (confirmed: census-app.scorecardresearch.com) ---
DOMAIN-SUFFIX,scorecardresearch.com,REJECT

# --- Kochava install attribution (listed in NSPrivacyTrackingDomains) ---
DOMAIN-SUFFIX,kochava.com,REJECT

# --- Microsoft Clarity session recording ---
DOMAIN-SUFFIX,clarity.ms,REJECT

# --- Firebase Analytics telemetry (crash reporting left untouched) ---
DOMAIN,app-measurement.com,REJECT
DOMAIN,firebaselogging-pa.googleapis.com,REJECT

# --- Deliberately NOT blocked ---
# sdk.privacy-center.org (Didomi CMP): blocking the consent platform can hang the
#   first-run consent flow; leave it reachable.
# appframework.pelmorex.com / *.pelmorex.com: first-party app config + data APIs;
#   the app can't function without them. We do NOT block the suffix — instead the
#   Script below rewrites ONLY the Config/getConfig response (banner toggle), while
#   every data/weather/search endpoint on this host passes through untouched.

[Script]
# Collapse the anchored-banner blank strip. The app pulls its whole config from
# Config/getConfig; anchoredBannerAd is its own per-screen "show a banner here?" switch
# (ships with news=false → news screen already has no banner box). The script flips all
# entries to false so no banner container is laid out anywhere. Subscription/Account
# state is never read or modified.
twn.nobanner = type=http-response,pattern=^https:\/\/appframework\.pelmorex\.com\/api\/appframework\/Config\/getConfig\/,requires-body=1,timeout=20,script-path=https://raw.githubusercontent.com/alexcding/proxy-rules/refs/heads/main/weathernetwork_noads.js,script-update-interval=0

[MITM]
hostname = %APPEND% appframework.pelmorex.com
